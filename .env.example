# Copy to .env and fill in.  .env is git-ignored  never commit real secrets.

# ── Database (matches docker-compose.yml) ────────────────────────────────────
POSTGRES_USER=mos
POSTGRES_PASSWORD=mos_dev_password
POSTGRES_DB=marketing_os
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Public base URL of the API. Tracking pixels and click-redirects are built from
# this, so it must be reachable by the recipient's email client.
PUBLIC_API_URL=http://localhost:8000
# Comma-separated origins allowed to call the API (the Next.js dashboard).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Email delivery (Phase 3) ─────────────────────────────────────────────────
# Leave SMTP_HOST empty to run in DRY-RUN mode: messages are rendered and
# recorded but never actually sent. Safe default for development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Marketing OS
SMTP_USE_TLS=true

# ── Dashboard ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
